[Unit]
Description=Trident Agent
After=network.target network-online.target systemd-udev-settle.service docker.service
Requires=docker.service

[Service]
ExecStartPre=/bin/bash /trident_cdrom/pre-trident-script.sh
ExecStartPre=/bin/bash -c "set -e; if ! docker image ls | grep -q 'trident/trident'; then curl $(grep -oP '^\s*phonehome: \\K.*(?=phonehome)' /etc/trident/config.yaml)files/trident-container.tar.gz -o /trident-container.tar.gz -f; fi"
ExecStartPre=/bin/bash -c "set -e; if ! docker image ls | grep -q 'trident/trident'; then docker load --input /trident-container.tar.gz; fi"
# Wait for containerd's task gRPC service before `docker run`: containerd.service
# is Type=simple, so systemd can start docker (and this unit) before containerd
# has registered io.containerd.grpc.v1.tasks, which makes `docker run` fail with
# "containerd.services.tasks.v1.Tasks: not implemented". Poll until it is ready.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do ctr tasks ls >/dev/null 2>&1 && exit 0; sleep 1; done; echo "timed out waiting for containerd task service" >&2; exit 1'
ExecStart=docker run --privileged -v /etc/trident:/etc/trident -v /run/initramfs/live:/trident_cdrom -v /var/lib/trident:/var/lib/trident -v /:/host -v /dev:/dev -v /run:/run -v /sys:/sys --pid host trident/trident:latest run
Type=oneshot

[Install]
WantedBy=multi-user.target
